<?xml version="1.0"?>
<launch>
    <arg name="map_frame" default="map"/>
    <arg name="base_frame" default="base_link"/>
    <arg name="cmd_vel_topic" default="/cmd_vel"/>
    <arg name="controller_freq" default="20.0"/>
    <arg name="pcd_file" default=""/>

    <!-- 运动学参数 -->
    <arg name="max_step_height" default="0.25"/>

    <!-- 机体碰撞建模参数 (与全局规划器保持一致) -->
    <arg name="footprint_radius" default="0.30"/>
    <arg name="body_hard_radius" default="0.20"/>
    <arg name="sweep_penalty_weight" default="1.0"/>
    <arg name="foot_clearance" default="0.05"/>
    <arg name="sor_mean_k" default="16"/>
    <arg name="sor_std_mul" default="1.5"/>

    <node pkg="elevation_local_planner" type="elevation_local_planner_node" name="elevation_local_planner" output="screen">
        <param name="map_frame" value="$(arg map_frame)"/>
        <param name="base_frame" value="$(arg base_frame)"/>
        <param name="cmd_vel_topic" value="$(arg cmd_vel_topic)"/>
        <param name="controller_freq" value="$(arg controller_freq)"/>
        <param name="pcd_file" value="$(arg pcd_file)"/>
        <param name="max_vel_x" value="0.8"/>
        <param name="max_vel_theta" value="1.0"/>
        <param name="lookahead_dist" value="0.8"/>
        <param name="max_step_height" value="$(arg max_step_height)"/>
        <param name="footprint_radius" value="$(arg footprint_radius)"/>
        <param name="body_hard_radius" value="$(arg body_hard_radius)"/>
        <param name="sweep_penalty_weight" value="$(arg sweep_penalty_weight)"/>
        <param name="foot_clearance" value="$(arg foot_clearance)"/>
        <param name="sor_mean_k" value="$(arg sor_mean_k)"/>
        <param name="sor_std_mul" value="$(arg sor_std_mul)"/>
    </node>
</launch>
