<?xml version="1.0"?>
<package format="2">
  <name>elevation_local_planner</name>
  <version>1.0.0</version>
  <description>Elevation and slope aware local trajectory planner and quadruped velocity controller</description>
  <maintainer email="user@todo.todo">Developer</maintainer>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>elevation_planner_core</depend>
  <depend>grid_map_core</depend>
  <depend>grid_map_ros</depend>
  <depend>grid_map_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>nav_core</depend>
  <depend>costmap_2d</depend>
  <depend>pluginlib</depend>
  <depend>pcl_ros</depend>
  <depend>pcl_conversions</depend>

  <export>
    <nav_core plugin="${prefix}/blp_plugins.xml" />
  </export>
</package>
