<?xml version="1.0"?>
<package format="2">
  <name>elevation_global_planner</name>
  <version>1.0.0</version>
  <description>Global 3D multi-layer manifold A* planner and path smoother for quadruped navigation</description>
  <maintainer email="user@todo.todo">Developer</maintainer>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>elevation_planner_core</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>pcl_ros</depend>
  <depend>pcl_conversions</depend>
  <depend>tf2_ros</depend>
  <depend>nav_core</depend>
  <depend>costmap_2d</depend>
  <depend>pluginlib</depend>

  <export>
    <nav_core plugin="${prefix}/bgp_plugins.xml" />
  </export>
</package>
